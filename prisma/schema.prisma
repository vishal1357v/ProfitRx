// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SESSION - Stores Shopify OAuth sessions
// ============================================
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String?
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean?
  locale              String?
  collaborator        Boolean?
  emailVerified       Boolean?
  refreshToken        String?
  refreshTokenExpires DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([shop])
  @@index([isOnline])
  @@map("sessions")
}

// ============================================
// ORDER - Stores Shopify orders
// ============================================
model Order {
  id                String   @id
  shop              String
  orderNumber       Int
  totalPrice        Float
  subtotalPrice     Float
  totalTax          Float
  shippingPrice     Float
  discountAmount    Float    @default(0)   // From totalDiscountsSet
  isCOD             Boolean  @default(false) // Derived from gateway
  createdAt         DateTime
  processedAt       DateTime
  financialStatus   String
  fulfillmentStatus String
  productId         String?  // First line item product id
  gateway           String?  // Payment gateway (COD / prepaid)
  channelType       String?  // e.g. "AI_CHAT", "SEARCH", "WEBSITE"
  channelAttribution String? // e.g. "Gemini", "ChatGPT", "Copilot", "Website"
  customerId        String?
  customerName      String?
  customerEmail     String?
  // Shipping address (for Pincode RTO heatmap)
  pincode           String?
  city              String?
  province          String?
  totalWeight       Float?   // Total weight in grams/kg
  cogsAtTimeOfOrder Float?
  actualShippingCost Float?
  shippingCostSource String  @default("ESTIMATED") // "MANUAL" | "COURIER" | "DEFAULT" | "ESTIMATED"
  // Risk Intelligence (Phase 3)
  riskScore         Int?
  riskLevel         String?
  riskReasons       Json?
  riskFlags         Json?
  merchantRecommendation String?
  lineItems         OrderLineItem[]
  refunds           OrderRefund[]
  executionLogs     ExecutionLog[]

  @@index([shop, createdAt])
  @@index([shop, pincode])
  @@index([shop, isCOD])
  @@index([shop, fulfillmentStatus])
  @@map("orders")
}

// ============================================
// EXECUTION LOG - Tracks pipeline execution for orders
// ============================================
model ExecutionLog {
  id          String   @id @default(cuid())
  shop        String
  orderId     String
  step        String   // "FEATURE_EXTRACTION", "RISK_CALCULATION", "DECISION", "EXECUTION"
  status      String   // "PENDING", "SUCCESS", "FAILED"
  message     String?
  data        Json?
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([shop, orderId])
  @@map("execution_logs")
}

// ============================================
// LEARNING RECORD - Tracks ML feedback loop
// ============================================
model LearningRecord {
  id          String   @id @default(cuid())
  shop        String
  orderId     String
  predictedRto Float
  actualRto    Boolean
  features    Json?
  createdAt   DateTime @default(now())

  @@index([shop])
  @@map("learning_records")
}

// ============================================
// ============================================
model OrderLineItem {
  id                  String   @id @default(cuid())
  shop                String
  orderId             String
  shopifyLineItemId   String
  productId           String?
  variantId           String?
  sku                 String?
  title               String
  variantTitle        String?
  quantity            Int
  unitPrice           Float
  originalUnitPrice   Float
  discountAmount      Float    @default(0)
  taxAmount           Float    @default(0)
  refundedQuantity    Int      @default(0)
  refundedAmount      Float    @default(0)
  cogsPerUnitAtOrder  Float?
  totalCOGSAtOrder    Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([shop, shopifyLineItemId])
  @@index([shop, orderId])
  @@index([shop, productId])
  @@index([shop, variantId])
  @@map("order_line_items")
}

model OrderRefund {
  id                   String           @id @default(cuid())
  shop                 String
  orderId              String
  shopifyRefundId      String
  createdAt            DateTime
  totalRefundAmount    Float            @default(0)
  shippingRefundAmount Float            @default(0)
  taxRefundAmount      Float            @default(0)
  currency             String           @default("INR")
  updatedAt            DateTime         @updatedAt
  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineItems            RefundLineItem[]

  @@unique([shop, shopifyRefundId])
  @@index([shop, orderId])
  @@map("order_refunds")
}

model RefundLineItem {
  id                String      @id @default(cuid())
  shop              String
  refundId          String
  orderId           String
  shopifyLineItemId String?
  quantity          Int
  refundAmount      Float       @default(0)
  taxRefundAmount   Float       @default(0)
  restocked         Boolean?
  cogsRecovered     Float?
  recoveryStatus    String      @default("UNKNOWN")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  refund            OrderRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@unique([refundId, shopifyLineItemId])
  @@index([shop, orderId])
  @@map("refund_line_items")
}

// PRODUCT COGS - Cost of Goods Sold per product
// ============================================
model ProductCOGS {
  id              String   @id @default(cuid())
  shop            String
  productId       String
  variantId       String?
  cost            Float?   // Effective COGS
  source          String   @default("manual_override") // "shopify_native" | "manual_override"
  manualOverride  Float?
  shopifyNative   Float?
  cogs            Float    @default(0) // Legacy compatibility field
  lastSyncedAt    DateTime?
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([shop, productId])
  @@index([shop, productId])
  @@map("product_cogs")
}

// ============================================
// VARIANT COGS - Cost of Goods Sold per variant (Phase 2)
// ============================================
model VariantCOGS {
  id              String   @id @default(cuid())
  shop            String
  productId       String
  variantId       String
  shopifyVariantId String?
  cost            Float?   // Effective COGS
  source          String   @default("manual_override") // "shopify_native" | "manual_override"
  manualOverride  Float?
  shopifyNative   Float?
  cogs            Float    @default(0) // Legacy compatibility field
  lastSyncedAt    DateTime?
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([shop, variantId])
  @@index([shop, productId])
  @@map("variant_cogs")
}

// ============================================
// AI SEARCH QUERY - Stores AI search visibilities
// ============================================
model AISearchQuery {
  id          String   @id @default(cuid())
  shop        String
  query       String
  productName String
  rank        Int      // Visibility rank in AI search (1st, 2nd, etc.)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  ctr         Float    @default(0.0)
  channel     String   // "ChatGPT", "Copilot", "Gemini"
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([shop])
  @@map("ai_search_queries")
}

// ============================================
// RTO/COD TRACKING - Your Moat Feature
// ============================================
model RTOEvent {
  id          String   @id @default(cuid())
  shop        String
  orderId     String
  orderNumber Int
  eventType   String   // "RTO", "COD_FAILURE", "DELIVERY_FAILED"
  reason      String?
  amount      Float    // Loss amount in ₹
  status      String   // "PENDING", "CONFIRMED", "RESOLVED"
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([shop, createdAt])
  @@index([orderId])
  @@unique([shop, orderId, eventType])
  @@map("rto_events")
}

// ============================================
// PINCODE STATS - Aggregated RTO data per pincode
// ============================================
model PincodeStats {
  id            String   @id @default(cuid())
  shop          String
  pincode       String
  city          String?
  province      String?
  totalOrders   Int      @default(0)
  codOrders     Int      @default(0)
  rtoCount      Int      @default(0)
  totalLoss     Float    @default(0)  // Total ₹ lost to RTO
  rtoRate       Float    @default(0)  // rtoCount / codOrders × 100
  riskLevel     String   @default("LOW")  // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  successfulDeliveries Int @default(0)
  deliveryRate  Float    @default(0)
  aov           Float    @default(0)
  revenue       Float    @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([shop, pincode])
  @@index([shop])
  @@index([shop, rtoRate])
  @@map("pincode_stats")
}

// ============================================
// CUSTOMER PROFILE - Cached customer LTV data
// ============================================
model CustomerProfile {
  id              String   @id @default(cuid())
  shop            String
  customerId      String
  customerName    String?
  customerEmail   String?
  firstOrderDate  DateTime?
  lastOrderDate   DateTime?
  orderCount      Int      @default(0)
  totalRevenue    Float    @default(0)
  totalProfit     Float    @default(0)
  ltv             Float    @default(0)  // Lifetime value
  aov             Float    @default(0)  // Average order value
  repeatRate      Float    @default(0)  // % of months with purchase
  cohortMonth     String?  // "2025-01" format for cohort analysis
  channelSource   String?  // First acquisition channel
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([shop, customerId])
  @@index([shop])
  @@index([shop, cohortMonth])
  @@map("customer_profiles")
}

// ============================================
// CUSTOMER RISK - Persistent Customer Risk History
// ============================================
model CustomerRisk {
  id              String   @id @default(cuid())
  shop            String
  customerId      String
  phone           String?
  email           String?
  totalOrders     Int      @default(0)
  codOrders       Int      @default(0)
  prepaidOrders   Int      @default(0)
  successfulDeliveries Int @default(0)
  rtoCount        Int      @default(0)
  cancellationCount Int    @default(0)
  aov             Float    @default(0)
  lifetimeSpend   Float    @default(0)
  lastOrderDate   DateTime?
  riskScore       Int      @default(0)
  riskLevel       String   @default("LOW")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([shop, customerId])
  @@index([shop])
  @@index([shop, phone])
  @@map("customer_risk")
}

// ============================================
// AD SPEND - Connected Platform OAuth & Manual Ad Spend
// ============================================
model AdSpend {
  id              String   @id @default(cuid())
  shop            String
  platform        String   // "meta" | "google" | "tiktok" | "manual"
  accountId       String?
  accessToken     String?  // Encrypted token
  refreshToken    String?  // Encrypted refresh token
  tokenExpiresAt  DateTime?
  lastSyncedAt    DateTime?
  isConnected     Boolean  @default(false)
  month           String?  // Legacy manual entry month format "2025-01"
  channel         String?  // Legacy manual channel
  amount          Float?   // Legacy manual spend amount in ₹
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([shop, platform])
  @@index([shop])
  @@map("ad_spend")
}

// ============================================
// AD SPEND DAILY - Auto-synced daily ad spend tracking
// ============================================
model AdSpendDaily {
  id              String   @id @default(cuid())
  shop            String
  platform        String
  date            DateTime
  spend           Float
  clicks          Int?
  impressions     Int?
  createdAt       DateTime @default(now())

  @@unique([shop, platform, date])
  @@index([shop, date])
  @@map("ad_spend_daily")
}

// ============================================
// PROFIT SNAPSHOT - Daily profit intelligence
// (Replaces HealthScore for Profit Health AI)
// ============================================
model ProfitSnapshot {
  id               String   @id @default(cuid())
  shop             String
  date             DateTime
  // Core metrics
  revenue          Float    @default(0)
  profit           Float    @default(0)
  margin           Float    @default(0)
  cogs             Float    @default(0)
  fees             Float    @default(0)
  // Profit leaks
  rtoLoss          Float    @default(0)
  shippingOverage  Float    @default(0)
  discountLoss     Float    @default(0)
  codFailureLoss   Float    @default(0)
  totalLeak        Float    @default(0)
  // RTO
  rtoRate          Float    @default(0)
  codRate          Float    @default(0)
  // Health AI status
  healthStatus     String   @default("UNKNOWN")  // "HEALTHY", "WARNING", "CRITICAL"
  healthReasons    Json?    // Array of reason strings
  createdAt        DateTime @default(now())

  @@unique([shop, date])
  @@index([shop])
  @@index([shop, date])
  @@map("profit_snapshots")
}

// ============================================
// ALERTS - Store health alerts
// ============================================
model Alert {
  id          String   @id @default(cuid())
  shop        String
  type        String   // "PROFIT_DROP", "HIGH_RTO", "LOW_MARGIN"
  severity    String   // "INFO", "WARNING", "CRITICAL"
  message     String
  data        Json?    // Additional context
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  readAt      DateTime?

  @@index([shop])
  @@index([isRead])
  @@map("alerts")
}

// ============================================
// SUBSCRIPTION - Billing & Plans
// ============================================
model Subscription {
  id              String   @id @default(cuid())
  shop            String   @unique
  plan            String   // "STARTER", "GROWTH", "PRO"
  status          String   // "ACTIVE", "CANCELED", "EXPIRED"
  shopifyChargeId String?  // Shopify Billing API charge ID
  trialEndsAt     DateTime?
  expiresAt       DateTime?
  orderLimit      Int?     // 500, 2000, null for Pro
  ordersUsed      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("subscriptions")
}

// ============================================
// STORE SETTINGS - Per-store configuration
// ============================================
model StoreSettings {
  id                     String   @id @default(cuid())
  shop                   String   @unique
  currency               String   @default("INR")
  timezone               String   @default("Asia/Kolkata")
  defaultCOGSPct         Float    @default(40)
  defaultForwardShipping Float    @default(60)
  defaultReturnShipping  Float    @default(70)
  defaultCODHandling     Float    @default(40)
  defaultPackaging       Float    @default(10)
  defaultGatewayFeePct   Float    @default(2)
  rtoDetectionPattern    String   @default("rto,returned,undelivered,failed_delivery,rto-initiated,rto_initiated,shipped-rto,shiprocket-rto,delhivery_rto,rto-delhivery,rto-bluedart,return-to-origin,returned-to-sender")
  alertEmail             String?
  whatsappPhone          String?
  whatsappEnabled        Boolean  @default(false)
  rtoThreshold           Float    @default(10)
  marginThreshold        Float    @default(15)
  syncCapped             Boolean  @default(false)
  // COD Management Suite
  codBlockingEnabled     Boolean  @default(false)
  codBlockedPincodes     String[] @default([])
  otpVerificationEnabled Boolean  @default(false)
  partialPaymentEnabled  Boolean  @default(false)
  partialPaymentAmount   Float    @default(50)
  codFeeEnabled          Boolean  @default(false)
  codFeeAmount           Float    @default(30)
  codFeeType             String   @default("fixed") // "fixed" or "percentage"
  // GST Compliance Suite & Gateway Fees
  gstin                  String?
  merchantState          String?
  gstRate                Float    @default(18)
  isGstRegistered        Boolean  @default(false)
  hsnCodes               Json?
  gatewayFixedFee        Float    @default(0)
  shopifyPlanName        String?  // e.g. "Basic", "Shopify", "Advanced", "Plus"
  shippingSlabs          Json?    // Array of weight slabs: { maxWeightGrams: number, forwardCost: number, returnCost: number }
  // Merchant Rules Engine (Phase 3)
  rulesRejectCodOver     Float?
  rulesRequirePrepaidAbove Float?
  rulesDisableCodForPincodes String[] @default([])
  rulesAutoFlagRepeatOffenders Boolean @default(false)
  rulesRepeatOffenderThreshold Int     @default(2)
  rulesRepeatOffenderAction    String  @default("OTP") // "OTP" or "BLOCK"
  rulesAutoRequireOtp    Boolean  @default(false)
  // Phase 4: Onboarding
  onboardingStep         Int      @default(0)
  onboardingCompleted    Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("store_settings")
}

// ============================================
// COD ORDER - Verification, Deposit & Fee Tracking
// ============================================
model CODOrder {
  id              String   @id @default(cuid())
  orderId         String   @unique
  shop            String
  phone           String
  otp             String?
  otpAttempts     Int      @default(0)
  otpVerified     Boolean  @default(false)
  otpSentAt       DateTime?
  otpVerifiedAt   DateTime?
  partialPaid     Boolean  @default(false)
  partialAmount   Float?
  codFee          Float?
  status          String   @default("PENDING") // PENDING, OTP_SENT, VERIFIED, FAILED, CANCELED, LOCKED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop])
  @@map("cod_orders")
}

// ============================================
// HEALTH SCORE - Kept for backward compat (deprecated)
// ============================================
model HealthScore {
  id              String   @id @default(cuid())
  shop            String
  date            DateTime @default(now())
  score           Int      // 0-100
  profitMargin    Float
  rtoRate         Float
  aov             Float
  repeatRate      Float
  adCostPercent   Float
  discountPercent Float
  createdAt       DateTime @default(now())

  @@unique([shop, date])
  @@index([shop])
  @@index([date])
  @@map("health_scores")
}
